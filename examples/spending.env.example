# 163 邮箱授权码（不是登录密码）
MAIL_ADDR=you@163.com
MAIL_AUTH_CODE=replace-with-auth-code

# 邮箱与过滤（默认值可省）
MAIL_HOST=imap.163.com
MAIL_PORT=993
MAIL_MAILBOX=招行信用卡
MAIL_SUBJECT_KEYWORD=招商银行信用卡电子账单
MAIL_SINCE=01-Sep-2025

# 拉取间隔（秒），默认 900
MAIL_POLL_INTERVAL_SECONDS=900

# 数据根目录（容器内默认 /data，挂载 /srv/persistent/data/spending）
DATA_DIR=/data

# Cashew 同步（容器用 host 网络，所以能连宿主机回环）
CASHEW_BASE=http://127.0.0.1:13004
CASHEW_EMAIL=your-cashew-admin@example.com
CASHEW_PASSWORD=replace-with-cashew-password
